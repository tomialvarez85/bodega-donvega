# Copiá este archivo a `.env` y completá los valores. `.env` NO se commitea.

# Connection string de Postgres. Usada por la app (lib/db.ts), drizzle-kit y el seed.
#
# Vercel Postgres / Neon (Vercel > Storage > tu DB > .env.local, variable POSTGRES_URL o DATABASE_URL):
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
#
# Supabase (Project Settings > Database > Connection string > URI):
#   - Session pooler (puerto 5432): usalo en tu PC para `npm run db:migrate` y `db:seed`.
#     La conexión directa (db.REF.supabase.co) es solo IPv6 y falla desde muchas redes.
#     postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
#   - Transaction pooler (puerto 6543): recomendado como DATABASE_URL en Vercel (serverless).
#     postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
#   El cliente ya usa prepare: false y TLS automático para hosts remotos.
#   La contraseña va sin corchetes; si tiene caracteres especiales (@, #, /), codificalos (@ => %40).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- Panel de administración (/admin): Supabase Auth ---
# El login del panel usa Supabase Auth. Hay un único admin, creado a mano en el dashboard de
# Supabase (Authentication > Users > Add user, con "Auto Confirm User"). En Authentication >
# Sign In / Providers, desactivá "Allow new users to sign up" para que nadie más pueda registrarse.
# Ambas claves están en Project Settings > API (o "API Keys").

# URL del proyecto de Supabase, sin barra final. Ej: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública ("anon" / "publishable"). Es segura para el navegador: lo que protege los datos
# es que el registro esté desactivado y que el panel verifique la sesión en el servidor.
NEXT_PUBLIC_SUPABASE_ANON_KEY="PEGAR_ANON_KEY_AQUI"

# --- Imágenes de productos, combos y visitas (Supabase Storage) ---
# No necesita variables nuevas: usa NEXT_PUBLIC_SUPABASE_URL y la sesión del admin. Solo hay que
# crear una vez el bucket público "images" y sus políticas: pegá supabase/storage.sql en
# Supabase > SQL Editor > Run.

# --- Sitio público ---
# URL pública del sitio (sin barra final). Se usa para Open Graph, sitemap.xml y robots.txt.
# Opcional en Vercel: si no la definís se usa el dominio de producción del proyecto
# (VERCEL_PROJECT_PRODUCTION_URL). Definila cuando conectes un dominio propio.
# En local queda en http://localhost:3000.
NEXT_PUBLIC_SITE_URL="https://www.tudominio.com.ar"

# --- Checkout ---
# WhatsApp de la bodega, en formato internacional y solo dígitos (54 + 9 + código de área + número):
# es el destino del botón "Continuar por WhatsApp" de la confirmación del pedido. Se lee en el build.
# Si no se define, el botón no se muestra.
NEXT_PUBLIC_WHATSAPP_NUMBER="5492610000000"
