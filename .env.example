# Copiá este archivo a `.env` y completá los valores. `.env` NO se commitea.

# Connection string de Postgres. Usada por la app (lib/db.ts), drizzle-kit y el seed.
#
# Vercel Postgres / Neon (Vercel > Storage > tu DB > .env.local, variable POSTGRES_URL o DATABASE_URL):
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
#
# Supabase (Project Settings > Database > Connection string > URI):
#   - Session pooler / conexión directa (recomendado para migraciones, puerto 5432):
#     postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
#   - Transaction pooler (puerto 6543) también funciona en la app; el cliente ya usa prepare: false.
#   Si la contraseña tiene caracteres especiales (@, #, /), codificalos en URL (ej. @ => %40).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- Panel de administración (/admin) ---
# Una sola persona administra: sin tabla de usuarios, las credenciales viven acá.

# Email con el que se ingresa al panel.
ADMIN_EMAIL="dueno@donvega.com"

# Hash bcrypt de la contraseña (nunca la contraseña en texto plano).
# Generalo con:  npm run admin:hash
# En este archivo (.env) cada "$" del hash va escapado como "\$" (Next expande variables);
# el script ya imprime la línea lista para pegar. En Vercel se pega el hash sin barras.
ADMIN_PASSWORD_HASH="PEGAR_HASH_AQUI"

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres, aleatorio). Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si lo cambiás, se cierran todas las sesiones abiertas.
SESSION_SECRET="PEGAR_SECRETO_AQUI"

# --- Imágenes de productos (Vercel Blob) ---
# Vercel > Storage > Create > Blob (store PUBLICO) > conectalo al proyecto.
# Para desarrollo local copiá el token del store (Vercel > Storage > tu Blob > .env.local).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_XXXXXXXX_XXXXXXXXXXXXXXXX"

# --- Sitio público ---
# URL pública del sitio (sin barra final). Se usa para Open Graph, sitemap.xml y robots.txt.
# Opcional en Vercel: si no la definís se usa el dominio de producción del proyecto
# (VERCEL_PROJECT_PRODUCTION_URL). Definila cuando conectes un dominio propio.
# En local queda en http://localhost:3000.
NEXT_PUBLIC_SITE_URL="https://www.tudominio.com.ar"

# --- Checkout ---
# WhatsApp de la bodega, en formato internacional y solo dígitos (54 + 9 + código de área + número):
# es el destino del botón "Continuar por WhatsApp" de la confirmación del pedido. Se lee en el build.
# Si no se define, el botón no se muestra.
NEXT_PUBLIC_WHATSAPP_NUMBER="5492610000000"
